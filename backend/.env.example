# Copy this file to .env and fill in the values. Never commit .env.

# --- Database (PostgreSQL via Prisma) -----------------------------------------
# Connection used by the app. With a connection pooler (Supabase, Neon, ...) use the pooled URL here.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/healthcare"
# Direct (non-pooled) connection used by Prisma migrations. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/healthcare"

# --- Authentication (NextAuth) ------------------------------------------------
# Public URL of the FRONTEND: browsers reach this API through the frontend, so NextAuth must use that URL.
NEXTAUTH_URL="http://localhost:3000"
# Long random string. Must be identical in frontend/.env.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Google sign-in. Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub sign-in. Authorization callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# --- Links --------------------------------------------------------------------
# Public URL of the frontend, used to build links we send out (video call links in emails).
FRONTEND_URL="http://localhost:3000"

# --- Email (Gmail SMTP via Nodemailer) ----------------------------------------
# Gmail address plus an App Password (not the normal account password).
# If left empty, OTP emails are skipped and the code is printed to the backend console instead.
EMAIL_USER=""
EMAIL_PASS=""

# --- Payments (Razorpay) ------------------------------------------------------
# Also required to BUILD the backend: the Razorpay client is created when the routes load.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- AI health chat (Google Gemini) -------------------------------------------
GEMINI_API_KEY=""

# --- Video consultations (ZEGOCLOUD) ------------------------------------------
# From the ZEGOCLOUD console. The server secret is 32 characters and must stay on the server.
ZEGO_APP_ID=""
ZEGO_SERVER_SECRET=""
