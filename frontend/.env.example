# Copy this file to .env and fill in the values. Never commit .env.

# Base URL of the backend API server. Every /api/* request is forwarded here.
# Baked into the production build: rebuild the frontend after changing it.
BACKEND_URL="http://localhost:4000"

# NextAuth: lets middleware.ts read the session cookie to guard pages.
# Use exactly the same values as in backend/.env.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Razorpay PUBLIC key id (same value as the backend's RAZORPAY_KEY_ID). Safe to expose to browsers.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
